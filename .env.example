# Gueridon environment — copy to .env and fill in real values.
# The systemd service loads this via EnvironmentFile=.
# Live values are NOT in git: they live in /opt/gueridon/.env on the prod box.
# The VAPID private key is separate again — ~/.config/gueridon/vapid.json
# (regenerate per docs/deploy-guide.md §4 if lost; subscribers must re-subscribe).

# Required: your Tailscale HTTPS hostname (used for CORS origin)
TAILSCALE_HOSTNAME=your-host.your-tailnet.ts.net

# Push notification sender identity (mailto: URI)
VAPID_SUBJECT=mailto:you@example.com

# Suppress CC's built-in MCP server auto-discovery
ENABLE_CLAUDEAI_MCP_SERVERS=false

# Required: root the launcher scans for repos (two levels: owner/repo).
# Set it explicitly — the code default is ~/Repos (capital R, historical),
# which silently scans an empty dir on a machine whose checkout root is ~/repos.
SCAN_ROOT=/home/you/repos

# Teams lane (claude --remote-control spawns + the /launch, /rc, /sessions
# endpoints — all 404 when this is unset). Under review for retirement
# (gdn-sudacu); leave unset unless you want claude.ai-attached launches.
GUERIDON_ENABLE_RC=1

# Optional: override bridge listen port (default 3001)
# BRIDGE_PORT=3001

# Optional: VertexAI billing — add a second EnvironmentFile to the systemd unit
# pointing at your claude-vertex.env (e.g. ~/Repos/dotfiles/shell/claude-vertex.env).
# That file is the single source of truth for CLAUDE_CODE_USE_VERTEX, CLOUD_ML_REGION,
# ANTHROPIC_VERTEX_PROJECT_ID, and ANTHROPIC_DEFAULT_*_MODEL vars.

# Optional: override the model CC uses (e.g. "opus", "sonnet")
# CC_MODEL=opus
